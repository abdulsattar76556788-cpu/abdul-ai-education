<section id="chat">
<h2>🤖 AI Chatbot</h2>
<div class="panel">
<textarea id="chatInput" placeholder="اپنا سوال لکھیں..."></textarea>
<button onclick="chat()">Send Message</button>
<div class="output" id="chatOutput">آپ کا جواب یہاں آئے گا۔</div>
</div>
</section>

<section id="image">
<h2>🎨 AI Image Generator</h2>
<div class="panel">
<textarea id="imageInput" placeholder="تصویر کا خیال لکھیں..."></textarea>
<button onclick="imagePrompt()">Generate Prompt</button>
<div class="output" id="imageOutput"></div>
</div>
</section>

<section id="video">
<h2>🎬 AI Video Tools</h2>
<div class="panel">
<input id="videoInput" placeholder="ویڈیو کا موضوع لکھیں">
<button onclick="videoScript()">Create Video Script</button>
<div class="output" id="videoOutput"></div>
</div>
</section>

<section id="education">
<h2>📚 Education & MCQs</h2>
<div class="panel">
<h3>نمونہ جنرل نالج ٹیسٹ</h3>
<div id="quiz"></div>
<button onclick="checkQuiz()">Check Result</button>
<div class="output" id="quizOutput"></div>
</div>
</section>

<section id="tools">
<h2>🧰 All-in-One Smart Tools</h2>
<div class="panel">
<h3>Word Counter</h3>
<textarea id="wordText" oninput="countWords()" placeholder="اپنا متن لکھیں..."></textarea>
<div class="output" id="wordOutput">Words: 0 | Characters: 0</div>
<h3>Text Converter</h3>
<textarea id="convertText" placeholder="English text..."></textarea>
<button onclick="convert('upper')">UPPERCASE</button>
<button onclick="convert('lower')">lowercase</button>
<div class="output" id="convertOutput"></div>
</div>
</section>

<section>
<div class="admin">
<h2>👑 Founder & Chief Admin</h2>
<h1 style="color:#4cdbff">Abdul Sattar</h1>
<p>NEXORA AI Official Founder</p>
</div>
</section>

<footer>
<h2>NEXORA AI</h2>
<p>Founder & Chief Admin: Abdul Sattar</p>
<p>© 2026 NEXORA AI. All Rights Reserved.</p>
</footer>

<script>
function chat(){
let q=document.getElementById("chatInput").value.trim();
document.getElementById("chatOutput").textContent=q?
"آپ کا سوال موصول ہوگیا: "+q+"\n\nحقیقی AI جواب کے لیے AI API کنکشن ضروری ہے۔":
"براہ کرم سوال لکھیں۔";
}
function imagePrompt(){
let q=document.getElementById("imageInput").value.trim();
document.getElementById("imageOutput").textContent=q?
"Professional AI Image Prompt:\n"+q+"\nHigh quality, cinematic lighting, realistic details, professional composition.":
"تصویر کا خیال لکھیں۔";
}
function videoScript(){
let q=document.getElementById("videoInput").value.trim();
document.getElementById("videoOutput").textContent=q?
"Video Title: "+q+"\n\n1. Introduction\n2. Main Scene\n3. Important Details\n4. Conclusion\n5. Call to Action":
"موضوع لکھیں۔";
}
const questions=[
{q:"پاکستان کا دارالحکومت کیا ہے؟",o:["کراچی","اسلام آباد","لاہور"],a:1},
{q:"قرآن مجید کس نبی پر نازل ہوا؟",o:["حضرت موسیٰؑ","حضرت محمد ﷺ","حضرت عیسیٰؑ"],a:1},
{q:"پانی کا فارمولا کیا ہے؟",o:["H2O","CO2","O2"],a:0},
{q:"2+2 کتنے ہوتے ہیں؟",o:["3","4","5"],a:1},
{q:"پاکستان کب آزاد ہوا؟",o:["1940","1947","1950"],a:1}
];
document.getElementById("quiz").innerHTML=questions.map((q,i)=>
`<div style="padding:12px;border-bottom:1px solid #354767">
<strong>${i+1}. ${q.q}</strong><br>
${q.o.map((v,j)=>`<label><input style="width:auto" type="radio" name="q${i}" value="${j}"> ${v}</label><br>`).join("")}
</div>`).join("");
function checkQuiz(){
let score=0;
questions.forEach((q,i)=>{
let a=document.querySelector(`input[name="q${i}"]:checked`);
if(a && Number(a.value)===q.a)score++;
});
document.getElementById("quizOutput").textContent=
"آپ کا نتیجہ: "+score+" / "+questions.length;
}
function countWords(){
let t=document.getElementById("wordText").value;
let words=t.trim()?t.trim().split(/\s+/).length:0;
document.getElementById("wordOutput").textContent=
"Words: "+words+" | Characters: "+t.length;
}
function convert(type){
let t=document.getElementById("convertText").value;
document.getElementById("convertOutput").textContent=
type==="upper"?t.toUpperCase():t.toLowerCase();
}
</script>
</body>
