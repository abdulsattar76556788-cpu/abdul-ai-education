<style>
*{box-sizing:border-box}
body{margin:0;background:#080b18;color:#fff;font-family:Arial,sans-serif;line-height:1.8}
header{background:#10172b;padding:16px 5%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;border-bottom:1px solid #293858}
.logo{font-size:25px;font-weight:bold;color:#45d9ff}
nav{display:flex;gap:15px;flex-wrap:wrap}
nav a{color:#ddd;text-decoration:none;font-size:14px}
nav a:hover{color:#45d9ff}
.hero{text-align:center;padding:75px 20px;background:linear-gradient(135deg,#101a38,#261449)}
.hero h1{font-size:clamp(35px,7vw,60px);margin:10px;color:#4cdbff}
.hero p{color:#c3cce1}
button,.btn{background:linear-gradient(90deg,#27c9ff,#8865ff);border:0;padding:12px 22px;border-radius:10px;color:#07101c;font-weight:bold;cursor:pointer}
section{padding:35px 5%;max-width:1200px;margin:auto}
h2{color:#48d8ff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:17px}
.card,.panel{background:#111b30;border:1px solid #293957;padding:20px;border-radius:17px}
.card{text-align:center}
.card .icon{font-size:38px}
.card h3{color:#a99aff}
input,textarea,select{width:100%;padding:13px;margin:8px 0;background:#080f20;color:white;border:1px solid #354767;border-radius:9px}
textarea{min-height:100px}
.output{background:#080f20;padding:15px;border-radius:10px;margin-top:12px;white-space:pre-wrap;min-height:45px}
footer{text-align:center;padding:35px;background:#10172b;color:#aab5cd}
.admin{border:1px solid #8165ff;background:#171638;padding:25px;border-radius:18px;text-align:center}
@media(max-width:650px){header{flex-direction:column;gap:10px}nav{justify-content:center;gap:10px}.hero{padding:45px 15px}}
</style>
</head>
<body>

<header>
<div class="logo">NEXORA AI ✦</div>
<nav>
